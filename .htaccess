Options -Indexes

# The app now lives directly in the web root (no nested public/ folder), so
# these support files sit alongside the pages — block direct web access to them.
<FilesMatch "\.(sql|md|dist|example\.php|gitignore|gitattributes)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 (?i)/(config|includes|migration|private-uploads)(/|$)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP upload limits previously lived here (php_value inside <IfModule
# mod_php.c>) but the block is suspected of causing a raw HTTP 500 on
# every POST request on this host (signup, settings — anything with a
# body, even with no file attached) — removed entirely while that's
# confirmed. If uploads need a higher limit, set upload_max_filesize /
# post_max_size in hPanel > Advanced > PHP Configuration instead.
