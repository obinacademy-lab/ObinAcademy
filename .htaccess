Options -Indexes

# The old per-course platform was removed: its pages send visitors to the campuses (permanent redirect).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /OA/public/
  # become-affiliate.php and dashboard/affiliate.php are deliberately NOT in this list: those filenames
  # are back in use for the new student referral program (public/become-affiliate.php, public/dashboard/
  # learner/affiliate.php — a different path from the old dashboard/affiliate.php below, so no clash).
  RewriteRule ^(courses/.*|learn\.php|stream\.php|access\.php|profile\.php|bundle\.php|gift\.php|claim-gift\.php|certificate\.php|skills\.php|school-followers\.php|become-creator\.php|dashboard/creator/.*|dashboard/affiliate\.php|dashboard/gifts\.php|dashboard/learner/(following|payment-plans|subscriptions)\.php)$ index.php#campuses [R=301,NE,QSD,L]
</IfModule>

# PDF.js's viewer.mjs/pdf.mjs/pdf.worker.mjs are loaded as native ES module
# <script type="module"> — some servers' default MIME map doesn't include
# .mjs and falls back to text/plain, which combined with the
# X-Content-Type-Options: nosniff header below makes every browser hard-block
# the script (no fallback, no console-visible page error — the module script
# silently never runs, so the whole PDF viewer stays a blank shell: exactly
# the "PDF opens but shows nothing" symptom). Explicit mapping fixes it.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.mjs$">
    Header set Content-Type "text/javascript"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Raise PHP upload limits for course video uploads. Only takes effect if this
# server runs PHP as an Apache module (mod_php) — if it runs PHP-FPM instead
# (common on Hostinger), set these in hPanel > Advanced > PHP Configuration
# instead; this block is then silently ignored.
<IfModule mod_php.c>
  php_value upload_max_filesize 512M
  php_value post_max_size 512M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_value memory_limit 256M
</IfModule>
